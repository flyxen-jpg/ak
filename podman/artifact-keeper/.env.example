# Kopieren nach .env und Werte erzeugen:
#   sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -base64 48 | tr -d '\n')|" .env  usw.
# oder einfach ./setup.sh ausfuehren.
ARTIFACT_KEEPER_VERSION=latest
ARTIFACT_KEEPER_WEB_VERSION=latest
HTTP_PORT=30080
HTTPS_PORT=30443
SITE_ADDRESS=localhost
CORS_ORIGINS=http://localhost:30080

POSTGRES_USER=registry
POSTGRES_PASSWORD=
JWT_SECRET=
AK_WEBHOOK_SECRET_KEY=
ADMIN_PASSWORD=
DEPENDENCY_TRACK_ADMIN_PASSWORD=
