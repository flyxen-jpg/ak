# {{ ansible_managed }}
# This file was created from the role: {{ ansible_role_name }}
JF_SHARED_DATABASE_TYPE=postgresql
JF_SHARED_DATABASE_DRIVER=org.postgresql.Driver
JF_SHARED_DATABASE_URL=jdbc:postgresql://artifactory-postgres:5432/artifactory
JF_SHARED_DATABASE_USERNAME=artifactory
JF_SHARED_DATABASE_PASSWORD={{ artifactory_oss_db_password }}
JF_SHARED_EXTRAJAVAOPTS={{ artifactory_oss_java_opts }}
JF_ROUTER_ENTRYPOINTS_EXTERNALPORT={{ artifactory_oss_http_port }}
{% if artifactory_oss_small | bool %}
JF_ACCESS_EXTRAJAVAOPTS={{ artifactory_oss_access_java_opts }}
JF_JFBUS_EXTRAJAVAOPTS={{ artifactory_oss_jfbus_java_opts }}
JF_TOPOLOGY_EXTRAJAVAOPTS={{ artifactory_oss_helper_java_opts }}
JF_JFCONFIG_EXTRAJAVAOPTS={{ artifactory_oss_helper_java_opts }}
MALLOC_ARENA_MAX=2
{% endif %}
{% if not artifactory_oss_jfconnect_enabled | bool %}
JF_JFCONNECT_ENABLED=false
{% endif %}
{% for key, value in artifactory_oss_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
