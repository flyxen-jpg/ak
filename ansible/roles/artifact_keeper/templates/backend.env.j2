# {{ ansible_managed }}
# This file was created from the role: {{ ansible_role_name }}
HOST=0.0.0.0
PORT={{ artifact_keeper_backend_port }}
ENVIRONMENT=production
RUST_LOG={{ artifact_keeper_log_level }}
LOG_ANSI=false

# Database: local HAProxy forwards to the current Patroni primary.
DATABASE_URL={{ artifact_keeper_database_url }}
DATABASE_MAX_CONNECTIONS={{ artifact_keeper_database_max_connections }}
DATABASE_MIN_CONNECTIONS={{ artifact_keeper_database_min_connections }}
DATABASE_TCP_KEEPALIVES=true

# Shared secrets: identical on all nodes so tokens and encrypted values work cluster-wide.
JWT_SECRET={{ artifact_keeper_jwt_secret }}
AK_WEBHOOK_SECRET_KEY={{ artifact_keeper_webhook_secret_key }}
MIGRATION_ENCRYPTION_KEY={{ artifact_keeper_migration_encryption_key }}
SSO_ENCRYPTION_KEY={{ artifact_keeper_sso_encryption_key }}
ADMIN_PASSWORD={{ artifact_keeper_admin_password }}

AK_EXTERNAL_URL={{ artifact_keeper_external_url }}
CORS_ORIGINS={{ artifact_keeper_cors_origins | join(',') }}
RATE_LIMIT_TRUSTED_PROXY_CIDRS={{ artifact_keeper_trusted_proxy_cidrs }}
XFF_TRUSTED_FOR_AUTHZ=true
{% if artifact_keeper_ssrf_allow_private_cidrs | length > 0 %}
AK_SSRF_ALLOW_PRIVATE_CIDRS={{ artifact_keeper_ssrf_allow_private_cidrs }}
# Internal migration sources usually speak plain HTTP.
ALLOW_HTTP_INTEGRATIONS=1
{% endif %}
# Several replicas: coordinate upstream fetches of remote repositories via PostgreSQL locks.
PROXY_SINGLEFLIGHT_ADVISORY_LOCKS_ENABLED=true

# Search
OPENSEARCH_URL={{ artifact_keeper_opensearch_url }}

# Artifacts in S3 (Garage); /data only holds local scratch files.
STORAGE_BACKEND=s3
S3_BUCKET={{ artifact_keeper_s3_bucket }}
S3_REGION={{ artifact_keeper_s3_region }}
S3_ENDPOINT={{ artifact_keeper_s3_endpoint }}
S3_ACCESS_KEY_ID={{ garage_access_key_id }}
S3_SECRET_ACCESS_KEY={{ garage_secret_access_key }}
STORAGE_PATH=/data/storage
BACKUP_PATH=/data/backups
PLUGINS_DIR=/data/plugins
{% for key, value in artifact_keeper_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
