# {{ ansible_managed }}
# This file was created from the role: {{ ansible_role_name }}
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=production
RUST_LOG={{ ak_standalone_log_level }}
LOG_ANSI=false

# Database and search are reached by container name inside the private network.
DATABASE_URL=postgresql://{{ ak_standalone_db_user }}:{{ ak_standalone_db_password | urlencode }}@ak-postgres:5432/{{ ak_standalone_db_name }}
OPENSEARCH_URL=http://ak-opensearch:9200

STORAGE_BACKEND=filesystem
STORAGE_PATH=/data/storage
BACKUP_PATH=/data/backups
PLUGINS_DIR=/data/plugins

JWT_SECRET={{ ak_standalone_jwt_secret }}
AK_WEBHOOK_SECRET_KEY={{ ak_standalone_webhook_secret_key }}
MIGRATION_ENCRYPTION_KEY={{ ak_standalone_migration_encryption_key }}
SSO_ENCRYPTION_KEY={{ ak_standalone_sso_encryption_key }}
ADMIN_PASSWORD={{ ak_standalone_admin_password }}

AK_EXTERNAL_URL={{ ak_standalone_external_url }}
CORS_ORIGINS={{ ak_standalone_external_url }}
# Client IPs are taken from X-Forwarded-For only when the request comes through Caddy.
RATE_LIMIT_TRUSTED_PROXY_CIDRS={{ ak_standalone_subnet }}
XFF_TRUSTED_FOR_AUTHZ=true
{% if ak_standalone_ssrf_allow_private_cidrs | length > 0 %}
AK_SSRF_ALLOW_PRIVATE_CIDRS={{ ak_standalone_ssrf_allow_private_cidrs }}
ALLOW_HTTP_INTEGRATIONS=1
{% endif %}
DEPENDENCY_TRACK_ENABLED=false
{% for key, value in ak_standalone_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
