# {{ ansible_managed }}
# This file was created from the role: {{ ansible_role_name }}
global_defs {
    router_id {{ keepalived_router_id }}
    enable_script_security
    script_user root
    # Refresh gratuitous ARP regularly so switches/caches learn the VIP location quickly.
    vrrp_garp_master_refresh 30
}

{% if keepalived_track_process %}
# Hold the VIP only while the local {{ keepalived_track_process }} process is running.
vrrp_track_process track_{{ keepalived_track_process }} {
    process {{ keepalived_track_process }}
    weight {{ keepalived_track_weight }}
    delay 1
}

{% endif %}
vrrp_instance VI_AK {
    # All nodes start as BACKUP; together with nopreempt the VIP does not move back.
    state BACKUP
{% if keepalived_nopreempt %}
    nopreempt
{% endif %}
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_virtual_router_id }}
    priority {{ keepalived_priority }}
    advert_int {{ keepalived_advert_int }}
{% if keepalived_unicast %}
    unicast_src_ip {{ ak_cluster_ip }}
    unicast_peer {
{% for h in groups[keepalived_group] | difference([inventory_hostname]) %}
        {{ hostvars[h]['ak_cluster_ip'] }}
{% endfor %}
    }
{% endif %}
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ keepalived_vip }}/{{ keepalived_vip_prefix }} dev {{ keepalived_interface }} label {{ keepalived_interface }}:vip
    }
{% if keepalived_track_process %}
    track_process {
        track_{{ keepalived_track_process }}
    }
{% endif %}
}
