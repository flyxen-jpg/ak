# {{ ansible_managed }}
# This file was created from the role: {{ ansible_role_name }}
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"
replication_factor = {{ garage_replication_factor }}
# "consistent": reads and writes need a quorum, no stale reads after a node failure.
consistency_mode = "consistent"

rpc_bind_addr = "0.0.0.0:{{ garage_rpc_port }}"
rpc_public_addr = "{{ garage_listen_ip }}:{{ garage_rpc_port }}"
rpc_secret = "{{ garage_rpc_secret }}"

[s3_api]
s3_region = "{{ garage_s3_region }}"
api_bind_addr = "0.0.0.0:{{ garage_s3_port }}"
root_domain = ".s3.{{ ak_domain }}"

[admin]
api_bind_addr = "0.0.0.0:{{ garage_admin_port }}"
admin_token = "{{ garage_admin_token }}"
metrics_token = "{{ garage_admin_token }}"
